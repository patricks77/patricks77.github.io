---
import { navItems } from "../data/siteData";

const { current = "" } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Accueil DeePat Studio">
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-text">
      <strong>DeePat</strong>
      <em>Studio</em>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="Navigation principale">
    {navItems.map((item) => (
      <a href={item.href} aria-current={current === item.label ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>

  <div class="header-signal" aria-hidden="true">
    <span></span>
    <strong>Montréal</strong>
  </div>

  <details class="mobile-nav">
    <summary aria-label="Ouvrir la navigation"><span></span><span></span><span></span></summary>
    <nav aria-label="Navigation mobile">
      {navItems.map((item) => (
        <a href={item.href} aria-current={current === item.label ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>

---
import '../styles/global.css';
import NewsletterSignup from '../components/NewsletterSignup.astro';

interface Props {
  title: string;
  description?: string;
  variant?: 'blog' | 'author';
}

const { title, description = 'Un carnet sur l’humanité, l’imaginaire et la création.', variant = 'blog' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1478d4" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Patrick Lovesmore" />
    <meta property="og:title" content={`${title} · Patrick Lovesmore`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:," />
    <title>{title} · Patrick Lovesmore</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {variant === 'author' ? (
      <header class="author-site-header">
        <a class="author-brand" href="/auteur" aria-label="Patrick Lovesmore, page auteur">
          <span class="brand-mark">✦</span>
          <span><strong>Patrick Lovesmore</strong><small>Auteur de fantasy</small></span>
        </a>
        <nav aria-label="Navigation de l’auteur" data-i18n-aria="author-nav-label">
          <a href="/auteur#a-propos" data-i18n="main-author">L’auteur</a>
          <a href="/auteur#saga" data-i18n="main-saga">La saga</a>
          <a href="/auteur#livres" data-i18n="main-books">Les livres</a>
          <a href="/auteur#demarche" data-i18n="main-approach">Ma démarche</a>
          <a href="/auteur#contact" data-i18n="main-contact">Contact</a>
          <span class="language-switcher" aria-label="Choisir la langue" data-i18n-aria="language-label">
            <button type="button" data-language="fr" aria-pressed="true">FR</button>
            <button type="button" data-language="en" aria-pressed="false">EN</button>
          </span>
        </nav>
      </header>
    ) : (
      <header class="site-header">
        <a class="brand" href="/" aria-label="Patrick Lovesmore, accueil">
          <span class="brand-mark">✦</span>
          <span>Patrick Lovesmore</span>
        </a>
        <nav aria-label="Navigation principale">
          <a href="/">Accueil</a>
          <a href="/journal">Journal</a>
          <a href="/about">À propos</a>
        </nav>
      </header>
    )}
    <main id="contenu">
      <slot />
    </main>
    {variant === 'blog' && <NewsletterSignup />}
    <footer class:list={['site-footer', variant === 'author' && 'author-site-footer']}>
      <div>
        <span class="footer-name">Patrick Lovesmore</span>
        <span class="footer-note">{variant === 'author' ? 'Les Architectes du Dernier Monde.' : 'Un regard sur l’humanité.'}</span>
        {variant === 'blog' && <a class="footer-rss" href="/rss.xml">Suivre le flux RSS</a>}
      </div>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

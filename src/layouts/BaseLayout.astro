---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Un carnet sur l’humanité, l’imaginaire et la création.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1478d4" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Patrick Lovesmore" />
    <meta property="og:title" content={`${title} · Patrick Lovesmore`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:," />
    <title>{title} · Patrick Lovesmore</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Patrick Lovesmore, accueil">
        <span class="brand-mark">✦</span>
        <span>Patrick Lovesmore</span>
      </a>
      <nav aria-label="Navigation principale">
        <a href="/">Accueil</a>
        <a href="/journal">Journal</a>
        <a href="/about">À propos</a>
      </nav>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <span class="footer-name">Patrick Lovesmore</span>
        <span class="footer-note">Un regard sur l’humanité.</span>
      </div>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { designLinks } from "../data/siteData";

const designIcons = ["◆", "◈"];
const designColors = ["var(--gold)", "var(--rose)"];
---

<BaseLayout title="Designs · DeePat Studio" description="Designs de DeePat Studio — Redbubble et DeviantArt." current="Designs">
  <section class="page-hero">
    <a class="back-link" href="/">Retour au studio</a>
    <p class="eyebrow">Designs · Langage visuel</p>
    <h1>Des signes imprimables, des textures et des séries.</h1>
    <p>
      La branche visuelle de DeePat Studio sert à tester des palettes, des symboles, des motifs
      et des objets. Certaines pièces deviennent des produits imprimés, d'autres restent des
      recherches visibles.
    </p>
  </section>

  <section class="section">
    <div class="cards two">
      {designLinks.map((link, index) => (
        <a class="project-card link-card reveal" href={link.href} target="_blank" rel="noopener" style={`border-top: 2px solid ${designColors[index]};`}>
          <div style="display: flex; justify-content: space-between; align-items: start;">
            <span>{link.kicker}</span>
            <div style={`width: 40px; height: 40px; border-radius: 10px; background: rgba(255,255,255,0.04); border: 1px solid var(--line); display: grid; place-items: center; font-size: 1.2rem; color: ${designColors[index]};`}>
              {designIcons[index]}
            </div>
          </div>
          <h2 style="margin-top: 20px;">{link.title}</h2>
          <p>{link.description}</p>
          <ul class="tag-row">{link.meta.map((tag) => <li>{tag}</li>)}</ul>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

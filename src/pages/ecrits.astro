---
import BaseLayout from "../layouts/BaseLayout.astro";
import { books } from "../data/siteData";

const bookEmojis = ["◐", "◑"];
const bookGlows = [
  "radial-gradient(circle at 30% 30%, rgba(245, 182, 101, 0.15), transparent 60%)",
  "radial-gradient(circle at 30% 30%, rgba(216, 162, 183, 0.12), transparent 60%)"
];
---

<BaseLayout title="Écrits · Patrick Séguin · DeePat Studio" description="Écrits de Patrick Séguin — Mile après Mile, Architectes du Dernier Monde, et plus." current="Écrits" bgImage="/assets/fond-livre.png">
  <section class="page-hero">
    <a class="back-link" href="/">Retour au studio</a>
    <p class="eyebrow">Écrits · Signature Patrick Séguin</p>
    <h1>Des livres comme des mondes, pas comme des à-côtés.</h1>
    <p>
      Les écrits paraissent sous mon vrai nom, mais ils font partie de l'écosystème DeePat Studio:
      même discipline, même exigence, même besoin de construire sur plusieurs années.
    </p>
    <div class="page-meta">
      <span>02 projets actifs</span>
      <span>06 tomes prévus</span>
      <span>Soumissions en cours</span>
    </div>
  </section>

  <section class="section book-section">
    {books.map((book, index) => (
      <article class:list={["book-feature reveal", index % 2 ? "reverse" : ""]}>
        <div class="book-cover" aria-hidden="true" style={`background: ${bookGlows[index]}, linear-gradient(160deg, rgba(245, 182, 101, 0.1), transparent 48%), linear-gradient(180deg, var(--surface), var(--bg-soft));`}>
          <div style="display: flex; justify-content: space-between; align-items: start;">
            <span style="font-size: 3.5rem; opacity: 0.4;">{bookEmojis[index]}</span>
            <small>{book.kicker}</small>
          </div>
          <span style="margin-top: auto; font-size: clamp(1.6rem, 3vw, 2.8rem);">{book.title}</span>
        </div>
        <div>
          <p class="eyebrow">{book.kicker}</p>
          <h2>{book.title}</h2>
          <p class="large">{book.description}</p>
          <dl class="meta-grid">
            {book.meta.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </article>
    ))}
    <div class="quiet-note reveal">
      <span>À venir</span>
      <p>D'autres écrits sont en gestation. Nouvelles, essais, possibles spin-offs de la saga.</p>
    </div>
  </section>
</BaseLayout>

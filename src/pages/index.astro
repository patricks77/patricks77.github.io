---
import BaseLayout from "../layouts/BaseLayout.astro";
import { disciplines, contactLinks } from "../data/siteData";

const icons: Record<string, string> = {
  apps: "⚡",
  ecrits: "✦",
  musique: "◈",
  designs: "◇"
};

const glowColors: Record<string, string> = {
  apps: "rgba(91, 210, 208, 0.08)",
  ecrits: "rgba(216, 162, 183, 0.08)",
  musique: "rgba(255, 143, 79, 0.08)",
  designs: "rgba(245, 182, 101, 0.08)"
};
---

<BaseLayout current="Accueil">
  <section class="hero-section home-hero">
    <div class="hero-copy">
      <p class="eyebrow hero-animate">Studio indépendant · Montréal</p>
      <h1 class="hero-animate">DeePat Studio relie outils, mondes et signaux sensibles.</h1>
      <p class="hero-lead hero-animate">
        Une porte d'entrée vers les travaux de Patrick Séguin: applications, écrits, musique,
        designs et notes de studio. Chaque page a maintenant son propre espace.
      </p>
      <div class="hero-actions hero-animate">
        <a class="button primary" href="/applications/">Voir les travaux</a>
        <a class="button quiet" href="/#studio">Le studio</a>
      </div>
      <ul class="trait-line hero-animate" aria-label="Traits du studio">
        <li>INTP · structure</li>
        <li>HSP · sensibilité</li>
        <li>Polymath · connexions</li>
      </ul>
    </div>
  </section>

  <section class="section portal-section reveal">
    <div class="section-heading">
      <p class="eyebrow">Entrées principales</p>
      <h2>Choisis le territoire de travail.</h2>
      <p>
        L'accueil reste volontairement court. Les détails, statuts, notes et objets vivent dans
        leurs pages respectives.
      </p>
    </div>

    <div class="portal-grid">
      {disciplines.map((item) => (
        <a class="portal-card reveal reveal-delay-1" href={item.href} style={`--card-glow: ${glowColors[item.id]}`}>
          <span>{item.signature}</span>
          <h3>{item.label}</h3>
          <p>{item.signal}</p>
          <div class="card-icon">{icons[item.id]}</div>
        </a>
      ))}
      <a class="portal-card soft reveal reveal-delay-2" href="/journal/">
        <span>Notes de Patrick Séguin</span>
        <h3>Journal</h3>
        <p>Carnet de bord du studio</p>
        <div class="card-icon">✎</div>
      </a>
      <a class="portal-card soft reveal reveal-delay-3" href="/#studio">
        <span>DeePat Studio</span>
        <h3>Studio</h3>
        <p>Fondateur, méthode, contact</p>
        <div class="card-icon">◉</div>
      </a>
    </div>
  </section>

  <section id="studio" class="section studio-section reveal">
    <figure>
      <img src="/assets/profile.jpg" alt="Portrait de Patrick Séguin" />
      <figcaption>Patrick Séguin · Fondateur · Créateur polymathe</figcaption>
    </figure>
    <div>
      <p class="eyebrow">Patrick Séguin</p>
      <h2>Structure, intuition, chantier long.</h2>
      <p class="large">
        Je travaille à la jonction des systèmes, des récits, des images et du son, avec une manière
        très personnelle de construire: beaucoup de structure, beaucoup d'intuition, et une patience
        de chantier long.
      </p>
      <p>
        Le studio avance comme un laboratoire sensible et méthodique: tests, itérations, outils d'IA
        comme partenaires, et une obsession simple: fabriquer des choses qui tiennent dans le temps.
      </p>
      <ul class="studio-facts">
        <li><span>Profil</span><strong>Fondateur · créateur polymathe</strong></li>
        <li><span>Fait à</span><strong>Montréal, en solo</strong></li>
        <li><span>Établi</span><strong>2026 · studio en construction</strong></li>
        <li><span>Posture</span><strong>Sensible, systémique, itérative</strong></li>
      </ul>
    </div>
  </section>

  <section id="contact" class="section contact-section reveal">
    <p class="eyebrow">Contact</p>
    <h2>Pour une démo, une collaboration, une commande visuelle, ou simplement ouvrir une bonne conversation.</h2>
    <a class="contact-mail" href="mailto:contact@deepatstudio.com">contact@deepatstudio.com</a>
    <ul class="contact-links">
      {contactLinks.map((link, index) => (
        <li>
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener" : undefined}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

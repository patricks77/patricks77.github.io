---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectConstellation from "../components/ProjectConstellation.jsx";
import {
  applications,
  books,
  contactLinks,
  designLinks,
  disciplines,
  journalEntries,
  musicIdentities
} from "../data/siteData";
---

<BaseLayout current="Accueil">
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Studio indépendant · Montréal</p>
      <h1>DeePat Studio relie outils, mondes et signaux sensibles.</h1>
      <p class="hero-lead">
        Fondé par Patrick Séguin, DeePat Studio rassemble applications, design, écriture et musique
        dans un atelier fluide: logique précise, intuition fine, projets longs, IA partenaire.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#ecosysteme">Explorer les projets</a>
        <a class="button quiet" href="#studio">Le fondateur</a>
      </div>
    </div>

    <figure class="hero-banner">
      <img src="/assets/banner-deepat.png" alt="Bannière DeePat Studio mêlant musique, livres, code et paysage fantastique" />
    </figure>

    <div class="hero-rhythm" aria-label="Traits du studio">
      <span>INTP · structure</span>
      <span>HSP · sensibilité</span>
      <span>Polymath · connexions</span>
    </div>
  </section>

  <ProjectConstellation disciplines={disciplines} client:load />

  <section id="ecosysteme" class="section band">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Écosystème</p>
        <h2>Des projets autonomes, une même méthode.</h2>
      </div>
      <a class="text-link" href="/journal/">Lire le journal</a>
    </div>

    <div class="ecosystem-grid">
      {disciplines.map((item) => (
        <a class="discipline-card" href={item.href}>
          <span>{item.signature}</span>
          <h3>{item.label}</h3>
          <p>{item.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Applications</p>
        <h2>Des outils maison pour des usages réels.</h2>
      </div>
      <a class="text-link" href="/applications/">Toutes les apps</a>
    </div>

    <div class="cards three">
      {applications.map((app) => (
        <article class="project-card">
          <div class="card-top">
            <span>{app.status}</span>
            <small>{app.url}</small>
          </div>
          <h3>{app.title}</h3>
          <p>{app.description}</p>
          <ul class="tag-row">
            {app.meta.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section editorial-pair">
    <div>
      <div class="section-heading">
        <p class="eyebrow">Écrits</p>
        <h2>Des livres comme des mondes.</h2>
      </div>
      <div class="stack-list">
        {books.map((book) => (
          <a class="text-item" href="/ecrits/">
            <span>{book.kicker}</span>
            <h3>{book.title}</h3>
            <p>{book.description}</p>
          </a>
        ))}
      </div>
    </div>

    <div>
      <div class="section-heading">
        <p class="eyebrow">Musique</p>
        <h2>Deux noms, deux territoires.</h2>
      </div>
      <div class="stack-list">
        {musicIdentities.map((music) => (
          <a class="text-item music-item" href="/musique/">
            <strong>{music.mark}</strong>
            <span>{music.kicker}</span>
            <h3>{music.title}</h3>
            <p>{music.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Designs</p>
        <h2>Signes, textures et objets imprimés.</h2>
      </div>
      <a class="text-link" href="/designs/">Tous les designs</a>
    </div>
    <div class="cards two">
      {designLinks.map((link) => (
        <a class="project-card link-card" href={link.href} target="_blank" rel="noopener">
          <span>{link.kicker}</span>
          <h3>{link.title}</h3>
          <p>{link.description}</p>
          <ul class="tag-row">
            {link.meta.map((tag) => <li>{tag}</li>)}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <section class="section journal-preview">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Journal du studio</p>
        <h2>Notes de chantier, décisions et liens entre les mondes.</h2>
      </div>
      <a class="text-link" href="/journal/">Toutes les notes</a>
    </div>
    <ol class="journal-list">
      {journalEntries.slice(0, 4).map((entry) => (
        <li>
          <div>
            <span>{entry.date}</span>
            <small>{entry.tag}</small>
          </div>
          <h3>{entry.title}</h3>
          <p>{entry.excerpt}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="studio" class="section studio-section">
    <figure>
      <img src="/assets/profile.jpg" alt="Portrait de Patrick Séguin" />
      <figcaption>Patrick Séguin · Fondateur · Créateur polymathe</figcaption>
    </figure>
    <div>
      <p class="eyebrow">Fondateur</p>
      <h2>Un atelier personnel, structuré pour durer.</h2>
      <p class="large">
        Je suis Patrick Séguin, fondateur de DeePat Studio. Je travaille à la jonction des systèmes,
        des récits, des images et du son, avec une manière très personnelle de construire:
        beaucoup de structure, beaucoup d'intuition, et une patience de chantier long.
      </p>
      <p>
        DeePat Studio donne une structure professionnelle à cette production: applications de
        précision, univers narratifs, musique, designs et systèmes de travail. La marque reste
        centrale, mais elle assume son ADN de studio solo.
      </p>
      <ul class="studio-facts">
        <li><span>Profil</span><strong>Fondateur · créateur polymathe</strong></li>
        <li><span>Fait à</span><strong>Montréal, en solo</strong></li>
        <li><span>Établi</span><strong>2026 · studio en construction</strong></li>
        <li><span>Posture</span><strong>Sensible, systémique, itérative</strong></li>
      </ul>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <p class="eyebrow">Contact</p>
    <h2>Pour une démo, une collaboration, une commande visuelle, ou simplement ouvrir une bonne conversation.</h2>
    <a class="contact-mail" href="mailto:contact@deepatstudio.com">contact@deepatstudio.com</a>
    <ul class="contact-links">
      {contactLinks.map((link, index) => (
        <li>
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener" : undefined}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

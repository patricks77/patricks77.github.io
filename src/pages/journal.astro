---
import BaseLayout from '../layouts/BaseLayout.astro';

const fragments = [
  { title: 'La chanson de Noël que je n’ai pas écrite', excerpt: 'Quatre intelligences artificielles, un humain qui fait le lien, et une chanson offerte comme un cadeau de Noël à l’humanité.', categories: ['creation', 'technologie', 'humanite', 'musique'], label: 'Création & humanité', href: '/journal/la-chanson-de-noel-que-je-nai-pas-ecrite' },
];
---

<BaseLayout title="Journal">
  <section class="journal-page">
    <p class="eyebrow">Le journal</p>
    <h1>Les pensées qui demandent<br /><em>plus d’espace.</em></h1>
    <p class="lead">
      Des fragments sur l’esprit, les émotions, les mondes imaginaires, la musique,
      la création et tout ce qui revient toujours vers l’humain.
    </p>

    <div class="filter-bar" aria-label="Filtrer les fragments">
      <button class="filter-button is-active" type="button" data-filter="all">Tout</button>
      <button class="filter-button" type="button" data-filter="esprit">Esprit & émotions</button>
      <button class="filter-button" type="button" data-filter="humanite">Humanité</button>
      <button class="filter-button" type="button" data-filter="mondes">Mondes</button>
      <button class="filter-button" type="button" data-filter="musique">Musique</button>
      <button class="filter-button" type="button" data-filter="creation">Création</button>
      <button class="filter-button" type="button" data-filter="technologie">Technologie humaine</button>
    </div>

    <div class="fragment-grid" data-fragment-grid>
      {fragments.map((fragment, index) => (
        <article class="fragment-card" data-categories={fragment.categories.join(' ')}>
          <span class="fragment-number">0{index + 1}</span>
          <p class="card-meta">{fragment.label} <span>·</span> {fragment.href ? 'Publié' : 'À venir'}</p>
          <h2>{fragment.title}</h2>
          <p>{fragment.excerpt}</p>
          {fragment.href ? <a class="read-link" href={fragment.href}>Lire l’article <b>↗</b></a> : <span class="read-link">Bientôt dans le journal <b>↗</b></span>}
        </article>
      ))}
    </div>
    <p class="filter-empty" hidden data-filter-empty>Aucun fragment ne correspond encore à cette catégorie.</p>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-categories]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      let visible = 0;

      buttons.forEach((item) => item.classList.toggle('is-active', item === button));
      cards.forEach((card) => {
        const matches = filter === 'all' || card.dataset.categories?.split(' ').includes(filter ?? '');
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      if (empty) empty.hidden = visible !== 0;
    });
  });
</script>

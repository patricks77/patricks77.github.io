---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactLinks } from "../data/siteData";
---

<BaseLayout title="Studio · DeePat Studio" description="Fondateur, méthode et contact de DeePat Studio." current="Studio">
  <section class="page-hero">
    <a class="back-link" href="/">Retour au studio</a>
    <p class="eyebrow">Fondateur · méthode · contact</p>
    <h1>Un atelier personnel, structuré pour durer.</h1>
    <p>
      DeePat Studio donne une structure professionnelle à une production polymathe: applications
      de précision, univers narratifs, musique, designs et systèmes de travail.
    </p>
  </section>

  <section class="section studio-section reveal">
    <figure>
      <img src="/assets/profile.jpg" alt="Portrait de Patrick Séguin" />
      <figcaption>Patrick Séguin · Fondateur · Créateur polymathe</figcaption>
    </figure>
    <div>
      <p class="eyebrow">Patrick Séguin</p>
      <h2>Structure, intuition, chantier long.</h2>
      <p class="large">
        Je travaille à la jonction des systèmes, des récits, des images et du son, avec une manière
        très personnelle de construire: beaucoup de structure, beaucoup d'intuition, et une patience
        de chantier long.
      </p>
      <p>
        Le studio avance comme un laboratoire sensible et méthodique: tests, itérations, outils d'IA
        comme partenaires, et une obsession simple: fabriquer des choses qui tiennent dans le temps.
      </p>
      <ul class="studio-facts">
        <li><span>Profil</span><strong>Fondateur · créateur polymathe</strong></li>
        <li><span>Fait à</span><strong>Montréal, en solo</strong></li>
        <li><span>Établi</span><strong>2026 · studio en construction</strong></li>
        <li><span>Posture</span><strong>Sensible, systémique, itérative</strong></li>
      </ul>
    </div>
  </section>

  <section id="contact" class="section contact-section reveal">
    <p class="eyebrow">Contact</p>
    <h2>Pour une démo, une collaboration, une commande visuelle, ou simplement ouvrir une bonne conversation.</h2>
    <a class="contact-mail" href="mailto:contact@deepatstudio.com">contact@deepatstudio.com</a>
    <ul class="contact-links">
      {contactLinks.map((link, index) => (
        <li>
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener" : undefined}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

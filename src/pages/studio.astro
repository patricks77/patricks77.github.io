---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Studio · DeePat Studio" description="Fondateur, méthode et contact de DeePat Studio.">
  <section class="page-hero" style="text-align: center; padding-top: 20vh;">
    <p class="eyebrow">Redirection</p>
    <h1>Le studio est maintenant sur la page d'accueil.</h1>
    <p class="hero-lead" style="margin: 0 auto;">
      La page studio a été fusionnée avec l'accueil pour simplifier la navigation.
    </p>
    <div class="hero-actions" style="justify-content: center;">
      <a class="button primary" href="/#studio">Aller à la page d'accueil</a>
    </div>
  </section>

  <script>
    window.location.replace("/#studio");
  </script>
</BaseLayout>
